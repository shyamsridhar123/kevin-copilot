{
  "name": "kevin-copilot",
  "version": "0.2.3",
  "description": "Make GitHub Copilot responses terse — across VS Code Chat, Copilot CLI, cloud agent, and code review. One command drops AGENTS.md, copilot-instructions.md, chat modes, and prompts into your repo. Measured 40–75% fewer response tokens without hurting correctness.",
  "bin": {
    "kevin-copilot": "./bin/kevin-copilot.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/args.test.ts test/templates.test.ts test/install.test.ts",
    "evals": "tsx evals/run.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "github-copilot",
    "copilot",
    "copilot-chat",
    "copilot-instructions",
    "chatmode",
    "prompt",
    "agents-md",
    "terse",
    "concise",
    "token-savings",
    "llm",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.7.2",
    "@types/node": "^20.12.7",
    "gpt-tokenizer": "^2.1.2"
  }
}
